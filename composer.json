{
    "config" : {
        "platform" : {
            "php" : "7.4.0"
        }
    },
    "require": {
        "php": ">=7.4",
        "microsoft/microsoft-graph": "1.109.1",
        "google/apiclient": "^2.9",
        "ovh/ovh": "^3.5",
        "docusign/esign-client": "^8.8",
        "lcobucci/jwt": "^3.4.6",
        "lcobucci/clock": "1.1.0",
        "league/oauth2-client": "^2.6",
        "stevenmaguire/oauth2-microsoft": "^2.2",
        "loicboursin/oauth2-microsoft-graph": "^0",
        "league/oauth2-google": "^3.0.4",
        "sarhan/oauth2-docusign": "^2.0",
        "cache/filesystem-adapter": "^1.1",
        "symfony/cache": "5.4.*",
        "symfony/service-contracts": "1.1.*",
        "psr/container": "2.0.1",
        "symfony/var-exporter": "4.4.*",
        "johngrogg/ics-parser": "^3.0.0",
        "t4web/composer-lock-parser": "1.1.*"
    },
    "autoload": {
        "exclude-from-classmap": [
            "vendor/microsoft/microsoft-graph/src/Beta/"
        ]
    },
    "scripts": {
        "post-install-cmd": [
            "@php build/composer_cleanup.php"
        ],
        "post-update-cmd": [
            "Google\\Task\\Composer::cleanup",
            "@php build/composer_cleanup.php"
        ]
    },
    "extra": {
        "google/apiclient-services": [
            "Gmail",
            "Calendar",
            "PeopleService",
            "Drive",
            "Sheets"
        ]
    }
}